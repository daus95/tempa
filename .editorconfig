root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

# Matches the eol=crlf entries in .gitattributes (Windows-only launchers).
[{tempa.cmd,"Open Dashboard.cmd"}]
end_of_line = crlf
